PORT=4000
JWT_SECRET=replace-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/
MONGODB_DATABASE=health_city_pharmacy

# Mobile money prompt payments.
# Leave these blank to run the providers in sandbox mode (prompts are simulated).
# Fill them in with the merchant credentials issued by Vodacom / Econet to send
# real payment prompts to customer phones.

# Vodacom Lesotho M-Pesa (OpenAPI — business.m-pesa.com, market vodacomLES)
# Get MPESA_API_KEY and MPESA_PUBLIC_KEY from the Vodacom developer portal
# (openapiportal.m-pesa.com) after registering your application.
MPESA_ENVIRONMENT=sandbox          # sandbox = test only, openapi = real customer phones
MPESA_MARKET=vodacomLES
MPESA_BASE_URL=https://openapi.m-pesa.com
MPESA_API_KEY=
MPESA_PUBLIC_KEY=
MPESA_SERVICE_PROVIDER_CODE=95899

# Econet Lesotho EcoCash (merchant API)
ECOCASH_BASE_URL=
ECOCASH_PAYMENT_PATH=/api/v1/transactions/amount/
ECOCASH_MERCHANT_CODE=
ECOCASH_API_USERNAME=
ECOCASH_API_PASSWORD=
ECOCASH_CHANNEL=USSD
